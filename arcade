    // Helper: Image Compressor
    function compressImageFile(file, maxWidth, quality, callback) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          const compressedDataUrl = canvas.toDataURL('image/jpeg', quality);
          callback(compressedDataUrl);
        };
        img.onerror = function() {
          callback(e.target.result);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    // Real-time Cloud Sync Initialization Function
    async function initCloudSync() {
      if (!firebaseConfig) {
        console.warn("Firebase config not available, using in-memory state.");
        gameDatabase = [...defaultGameDatabase];
        filterGames();
        renderDashboardAnalytics();
        return;
      }

      try {
        const app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);

        // Rule 3: Auth Before Queries
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
        if (initialAuthToken) {
          const cred = await signInWithCustomToken(auth, initialAuthToken);
          currentUser = cred.user;
        } else {
          const cred = await signInAnonymously(auth);
          currentUser = cred.user;
        }

        if (!currentUser) return;

        // Rule 1: Public Collection Strict Path
        gamesCollectionRef = collection(db, 'artifacts', appId, 'public', 'data', 'games');

        // Real-Time Listener on Firestore Collection
        onSnapshot(gamesCollectionRef, (snapshot) => {
          let cloudGames = [];
          snapshot.forEach((docSnap) => {
            cloudGames.push(docSnap.data());
          });

          if (cloudGames.length === 0) {
            defaultGameDatabase.forEach(async (g) => {
              await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'games', String(g.id)), g);
            });
          } else {
            gameDatabase = cloudGames;
            filterGames();
            renderDashboardAnalytics();
          }
        }, (err) => {
          console.error("Firestore Real-Time Listener Error:", err);
        });

      } catch (err) {
        console.error("Firebase Cloud Auth Error:", err);
        gameDatabase = [...defaultGameDatabase];
        filterGames();
        renderDashboardAnalytics();
      }
    }

    // Real-Time Save/Update Helper to Firestore
    async function syncGameToCloud(game) {
      if (!db || !currentUser) return;
      try {
        const gameDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'games', String(game.id));
        await setDoc(gameDocRef, game);
      } catch (err) {
        console.error("Error syncing game to cloud:", err);
      }
    }

    // Real-Time Delete Helper from Firestore
    async function deleteGameFromCloud(gameId) {
      if (!db || !currentUser) return;
      try {
        const gameDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'games', String(gameId));
        await deleteDoc(gameDocRef);
      } catch (err) {
        console.error("Error deleting game from cloud:", err);
      }
    }

