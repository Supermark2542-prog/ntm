    function toggleFullscreen() {
      const targetElem = document.getElementById('player-viewport-container');
      const isNativeFs = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);

      if (isNativeFs || isSimulatedFs) {
        exitFullscreenMode();
        return;
      }

      let promise = null;
      try {
        if (targetElem.requestFullscreen) {
          promise = targetElem.requestFullscreen();
        } else if (targetElem.webkitRequestFullscreen) {
          promise = targetElem.webkitRequestFullscreen();
        } else if (targetElem.mozRequestFullScreen) {
          promise = targetElem.mozRequestFullScreen();
        } else if (targetElem.msRequestFullscreen) {
          promise = targetElem.msRequestFullscreen();
        } else {
          enableSimulatedFullscreen();
          return;
        }

        if (promise && promise.catch) {
          promise.catch(() => {
            enableSimulatedFullscreen();
          });
        }
      } catch (err) {
        enableSimulatedFullscreen();
      }
    }

    function enableSimulatedFullscreen() {
      isSimulatedFs = true;
      document.body.classList.add('simulated-fullscreen-active');
      updateFullscreenButtonUI();
    }

    function exitFullscreenMode() {
      if (isSimulatedFs) {
        isSimulatedFs = false;
        document.body.classList.remove('simulated-fullscreen-active');
        updateFullscreenButtonUI();
      }

      try {
        if (document.fullscreenElement || document.webkitFullscreenElement) {
          if (document.exitFullscreen) {
            document.exitFullscreen().catch(() => {});
          } else if (document.webkitExitFullscreen) {
            document.webkitExitFullscreen();
          } else if (document.mozCancelFullScreen) {
            document.mozCancelFullScreen();
          } else if (document.msExitFullscreen) {
            document.msExitFullscreen();
          }
        }
      } catch (e) {
        // Ignore exit errors
      }
    }

    function updateFullscreenButtonUI() {
      const isNativeFs = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
      const isFs = isNativeFs || isSimulatedFs;
      
      const topBtn = document.getElementById('btn-fullscreen-top');
      const bottomBtn = document.getElementById('btn-fullscreen-bottom');

      if (isFs) {
        topBtn.innerHTML = `<span>↙️</span> <span class="hidden sm:inline">ย่อจอ</span>`;
        topBtn.classList.replace('bg-slate-800', 'bg-indigo-600');
        topBtn.classList.replace('text-slate-300', 'text-white');

        bottomBtn.innerHTML = `<span>↙️</span> <span>ย่อขนาดหน้าจอ</span>`;
        bottomBtn.classList.replace('bg-indigo-600', 'bg-slate-700');
      } else {
        topBtn.innerHTML = `<span>⛶</span> <span class="hidden sm:inline">เต็มจอ</span>`;
        topBtn.classList.replace('bg-indigo-600', 'bg-slate-800');
        topBtn.classList.replace('text-white', 'text-indigo-400');

        bottomBtn.innerHTML = `<span>⛶</span> <span>ขยายเต็มหน้าจอ</span>`;
        bottomBtn.classList.replace('bg-slate-700', 'bg-indigo-600');
      }
    }

    function initSelectedGame(type) {
      if (activeGameLoop) {
        cancelAnimationFrame(activeGameLoop);
        clearInterval(activeGameLoop);
      }

      const canvas = document.getElementById('game-canvas');
      const ctx = canvas.getContext('2d');
      currentGameScore = 0;
      document.getElementById('player-game-score').innerText = '0 คะแนน';

      if (type === 'space') {
        runSpaceShooterGame(canvas, ctx);
      } else if (type === 'brick') {
        runBrickBreakerGame(canvas, ctx);
      } else {
        runSnakeGame(canvas, ctx);
      }
    }

    function runSnakeGame(canvas, ctx) {
      document.getElementById('player-game-controls').innerText = 'ใช้ปุ่มลูกศร ⬅️ ➡️ ⬆️ ⬇️ บนคีย์บอร์ดเพื่อเลี้ยวงู • กด ⛶ เพื่อขยายเต็มจอ';
      
      const gridSize = 15;
      const tileCountX = canvas.width / gridSize;
      const tileCountY = canvas.height / gridSize;

      let snake = [{ x: 10, y: 10 }, { x: 9, y: 10 }];
      let dx = 1, dy = 0;
      let food = { x: 15, y: 10 };

      function handleKeyDown(e) {
        if (e.key === 'ArrowUp' && dy !== 1) { dx = 0; dy = -1; }
        if (e.key === 'ArrowDown' && dy !== -1) { dx = 0; dy = 1; }
        if (e.key === 'ArrowLeft' && dx !== 1) { dx = -1; dy = 0; }
        if (e.key === 'ArrowRight' && dx !== -1) { dx = 1; dy = 0; }
      }
      window.addEventListener('keydown', handleKeyDown);

      activeGameLoop = setInterval(() => {
        const head = { x: snake[0].x + dx, y: snake[0].y + dy };
        
        if (head.x < 0) head.x = tileCountX - 1;
        if (head.x >= tileCountX) head.x = 0;
        if (head.y < 0) head.y = tileCountY - 1;
        if (head.y >= tileCountY) head.y = 0;

        snake.unshift(head);

        if (head.x === food.x && head.y === food.y) {
          currentGameScore += 10;
          document.getElementById('player-game-score').innerText = currentGameScore + ' คะแนน';
          food = {
            x: Math.floor(Math.random() * tileCountX),
            y: Math.floor(Math.random() * tileCountY)
          };
        } else {
          snake.pop();
        }

        ctx.fillStyle = '#090d16';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#f43f5e';
        ctx.beginPath();
        ctx.arc((food.x * gridSize) + gridSize/2, (food.y * gridSize) + gridSize/2, gridSize/2 - 1, 0, Math.PI * 2);
        ctx.fill();

        snake.forEach((part, index) => {
          ctx.fillStyle = index === 0 ? '#10b981' : '#34d399';
          ctx.fillRect(part.x * gridSize, part.y * gridSize, gridSize - 1, gridSize - 1);
        });

      }, 90);
    }

    function runSpaceShooterGame(canvas, ctx) {
      document.getElementById('player-game-controls').innerText = 'ใช้ปุ่ม ⬅️ ➡️ เพื่อเลื่อนยาน และ Spacebar เพื่อยิง • กด ⛶ เพื่อขยายเต็มจอ';

      let playerX = canvas.width / 2 - 15;
      let bullets = [];
      let enemies = [];

      function handleSpaceKeys(e) {
        if (e.key === 'ArrowLeft' && playerX > 0) playerX -= 20;
        if (e.key === 'ArrowRight' && playerX < canvas.width - 30) playerX += 20;
        if (e.key === ' ' || e.code === 'Space') {
          bullets.push({ x: playerX + 13, y: canvas.height - 30 });
        }
      }
      window.addEventListener('keydown', handleSpaceKeys);

      activeGameLoop = setInterval(() => {
        if (Math.random() < 0.08) {
          enemies.push({ x: Math.random() * (canvas.width - 20), y: 0, speed: 2 + Math.random() * 2 });
        }

        ctx.fillStyle = '#090d16';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#6366f1';
        ctx.beginPath();
        ctx.moveTo(playerX + 15, canvas.height - 30);
        ctx.lineTo(playerX, canvas.height - 10);
        ctx.lineTo(playerX + 30, canvas.height - 10);
        ctx.fill();

        ctx.fillStyle = '#38bdf8';
        bullets.forEach((b, bi) => {
          b.y -= 7;
          ctx.fillRect(b.x, b.y, 4, 10);
          if (b.y < 0) bullets.splice(bi, 1);
        });

        ctx.fillStyle = '#f59e0b';
        enemies.forEach((enemy, ei) => {
          enemy.y += enemy.speed;
          ctx.beginPath();
          ctx.arc(enemy.x + 10, enemy.y + 10, 10, 0, Math.PI * 2);
          ctx.fill();

          bullets.forEach((b, bi) => {
            if (b.x >= enemy.x && b.x <= enemy.x + 20 && b.y >= enemy.y && b.y <= enemy.y + 20) {
              enemies.splice(ei, 1);
              bullets.splice(bi, 1);
              currentGameScore += 20;
              document.getElementById('player-game-score').innerText = currentGameScore + ' คะแนน';
            }
          });

          if (enemy.y > canvas.height) enemies.splice(ei, 1);
        });

      }, 1000 / 30);
    }

    function runBrickBreakerGame(canvas, ctx) {
      document.getElementById('player-game-controls').innerText = 'ใช้ปุ่ม ⬅️ ➡️ เพื่อเลื่อนไม้รับลูกบอล • กด ⛶ เพื่อขยายเต็มจอ';

      let paddleWidth = 75, paddleX = (canvas.width - paddleWidth) / 2;
      let x = canvas.width / 2, y = canvas.height - 30;
      let dx = 3, dy = -3;
      const ballRadius = 6;

      function handlePaddleKeys(e) {
        if (e.key === 'ArrowLeft' && paddleX > 0) paddleX -= 25;
        if (e.key === 'ArrowRight' && paddleX < canvas.width - paddleWidth) paddleX += 25;
      }
      window.addEventListener('keydown', handlePaddleKeys);

      activeGameLoop = setInterval(() => {
        ctx.fillStyle = '#090d16';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.beginPath();
        ctx.arc(x, y, ballRadius, 0, Math.PI * 2);
        ctx.fillStyle = '#ec4899';
        ctx.fill();
        ctx.closePath();

        ctx.fillStyle = '#8b5cf6';
        ctx.fillRect(paddleX, canvas.height - 15, paddleWidth, 10);

        if (x + dx > canvas.width - ballRadius || x + dx < ballRadius) dx = -dx;
        if (y + dy < ballRadius) dy = -dy;
        else if (y + dy > canvas.height - 15 - ballRadius) {
          if (x > paddleX && x < paddleX + paddleWidth) {
            dy = -dy;
            currentGameScore += 5;
            document.getElementById('player-game-score').innerText = currentGameScore + ' คะแนน';
          } else {
            x = canvas.width / 2;
            y = canvas.height - 30;
            dy = -3;
          }
        }

        x += dx;
        y += dy;
      }, 1000 / 40);
    }

    function renderDashboardAnalytics() {
      document.getElementById('stat-total-games').innerText = gameDatabase.length;
      
      const totalPlays = gameDatabase.reduce((acc, g) => acc + (g.plays || 0), 0);
      document.getElementById('stat-total-plays').innerText = totalPlays.toLocaleString();

      const activePlayedGames = gameDatabase.filter(g => (g.plays || 0) > 0);
      const devSet = new Set(activePlayedGames.map(g => g.developer));
      document.getElementById('stat-total-devs').innerText = devSet.size;

      const ratedGames = gameDatabase.filter(g => (g.rating || 0) > 0);
      const avgRating = ratedGames.length > 0 
        ? (ratedGames.reduce((acc, g) => acc + g.rating, 0) / ratedGames.length).toFixed(1)
        : "0.0";
      document.getElementById('stat-avg-rating').innerText = avgRating;

      const catCounts = {};
      Object.keys(categoryTheme).forEach(c => catCounts[c] = 0);
      gameDatabase.forEach(g => {
        catCounts[g.category] = (catCounts[g.category] || 0) + 1;
      });

      const catLabels = Object.keys(catCounts);
      const catData = Object.values(catCounts);
      const catColors = catLabels.map(c => categoryTheme[c].chart);

      const ctxCat = document.getElementById('gameCategoryChart').getContext('2d');
      if (categoryChartInstance) categoryChartInstance.destroy();

      categoryChartInstance = new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: catLabels,
          datasets: [{
            data: catData,
            backgroundColor: catColors,
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { font: { family: 'Prompt', size: 11 }, boxWidth: 12, padding: 12 }
            }
          }
        }
      });

      const ctxTrend = document.getElementById('gamePlaysTrendChart').getContext('2d');
      if (playsTrendChartInstance) playsTrendChartInstance.destroy();

      const thaiMonthsShort = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
      const now = new Date();
      const currentMonthIdx = now.getMonth();

      const trendLabels = [];
      for (let i = 3; i >= 0; i--) {
        let mIdx = (currentMonthIdx - i + 12) % 12;
        if (i === 0) {
          trendLabels.push(thaiMonthsShort[mIdx] + ' (Real-time)');
        } else {
          trendLabels.push(thaiMonthsShort[mIdx]);
        }
      }

      playsTrendChartInstance = new Chart(ctxTrend, {
        type: 'bar',
        data: {
          labels: trendLabels,
          datasets: [{
            label: 'จำนวนครั้งที่ถูกเปิดเล่น',
            data: [0, 0, 0, totalPlays],
            backgroundColor: '#10B981',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, ticks: { font: { family: 'Prompt', size: 11 } }, grid: { color: '#f1f5f9' } },
            x: { ticks: { font: { family: 'Prompt', size: 11 } }, grid: { display: false } }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

