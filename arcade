      const searchInput = document.getElementById('searchInput');
      const sortSelect = document.getElementById('sortSelect');
      const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const sortVal = sortSelect ? sortSelect.value : 'newest';

      let filtered = gameDatabase.filter(game => {
        const matchesCategory = currentCategoryFilter === 'ALL' || game.category === currentCategoryFilter;
        const matchesSearch = game.title.toLowerCase().includes(searchVal) ||
                              game.developer.toLowerCase().includes(searchVal) ||
                              game.description.toLowerCase().includes(searchVal);
        return matchesCategory && matchesSearch;
      });

      if (sortVal === 'popular') {
        filtered.sort((a, b) => (b.plays || 0) - (a.plays || 0));
      } else if (sortVal === 'rating') {
        filtered.sort((a, b) => (b.rating || 0) - (a.rating || 0));
      } else {
        filtered.sort((a, b) => b.id - a.id);
      }

      renderGameGrid(filtered);
