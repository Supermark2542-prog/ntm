<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NTM Arcade - ระบบอัปโหลดและเล่นเกมออนไลน์ (รองรับ AR)</title>
  
  <!-- Tailwind CSS CDN & Custom Configuration -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            arcade: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
            },
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9',
            }
          },
          fontFamily: {
            sans: ['Prompt', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts: Prompt -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body {
      font-family: 'Prompt', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .chart-container {
      position: relative;
      width: 100%;
      max-width: 550px;
      margin-left: auto;
      margin-right: auto;
      height: 280px;
      max-height: 350px;
    }
    @media (min-width: 768px) {
      .chart-container {
        height: 320px;
      }
    }
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .line-clamp-1 {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    #game-canvas {
      background-color: #090d16;
      border-radius: 12px;
      touch-action: none;
    }
    #game-iframe {
      background-color: #ffffff;
      border-radius: 12px;
      width: 100%;
      height: 440px;
      border: none;
    }

    /* Fullscreen Mode Styling */
    :fullscreen #player-viewport-container,
    :-webkit-full-screen #player-viewport-container {
      width: 100vw !important;
      height: 100vh !important;
      max-width: none !important;
      max-height: none !important;
      border-radius: 0 !important;
      background-color: #000000 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 10px !important;
    }

    :fullscreen #game-iframe,
    :-webkit-full-screen #game-iframe {
      height: 100% !important;
      width: 100% !important;
      border-radius: 0 !important;
    }

    :fullscreen #game-canvas,
    :-webkit-full-screen #game-canvas {
      max-height: 95vh !important;
      max-width: 95vw !important;
      object-fit: contain;
    }

    /* Simulated Fullscreen Fallback */
    .simulated-fullscreen-active #modal-container-box {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      max-width: 100vw !important;
      max-height: 100vh !important;
      border-radius: 0 !important;
      margin: 0 !important;
      padding: 12px !important;
      z-index: 99999 !important;
    }

    .simulated-fullscreen-active #player-viewport-container {
      flex-grow: 1 !important;
      height: calc(100vh - 120px) !important;
      max-height: none !important;
    }

    .simulated-fullscreen-active #game-iframe {
      height: 100% !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- Header / Navigation Bar -->
  <header class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white shadow-xl sticky top-0 z-30 border-b border-indigo-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between py-4 gap-4">
        
        <!-- Logo & Title -->
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-2xl shadow-lg shadow-indigo-500/30">
            🕹️
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-xl font-bold tracking-tight text-white">NTM Arcade</h1>
              <span class="px-2 py-0.5 text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full">v3.5 AR & Chrome Ready</span>
            </div>
            <p class="text-xs text-indigo-200 opacity-90 leading-tight">
              โรงเรียนวัดเนินตามาก<br>สพป. ชลบุรี เขต 2
            </p>
          </div>
        </div>

        <!-- Tab Controls -->
        <nav class="flex space-x-1 overflow-x-auto pb-1 md:pb-0 custom-scrollbar border-t md:border-t-0 border-white/10 pt-2 md:pt-0">
          <button onclick="switchTab('arcade')" id="tab-arcade" class="tab-btn active-tab px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-200 flex items-center gap-1.5 whitespace-nowrap bg-indigo-600 text-white shadow-md">
            <span>🎮</span> คลังเกม NTM (<span id="badge-game-count">0</span>)
          </button>
          <button onclick="switchTab('dashboard')" id="tab-dashboard" class="tab-btn px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-200 flex items-center gap-1.5 whitespace-nowrap text-indigo-200 hover:bg-white/10 hover:text-white">
            <span>📊</span> แดชบอร์ด & สถิติ
          </button>
          <button onclick="switchTab('upload')" id="tab-upload" class="tab-btn px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-200 flex items-center gap-1.5 whitespace-nowrap text-indigo-200 hover:bg-white/10 hover:text-white">
            <span>🚀</span> อัปโหลดเกมใหม่
          </button>
        </nav>

        <!-- Admin Quick Access Badge / Toggle -->
        <div class="flex items-center gap-2 pt-2 md:pt-0 border-t md:border-t-0 border-white/10">
          <button id="admin-toggle-btn" onclick="toggleAdminAuth()" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700">
            <span id="admin-badge-icon">🔐</span> <span id="admin-badge-text">เข้าสู่ระบบ Admin</span>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Toast Notification Banner -->
    <div id="toast-notification" class="hidden mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all">
      <div class="flex items-center gap-3">
        <span class="text-2xl">✅</span>
        <div>
          <h4 class="font-bold text-sm text-emerald-900">แจ้งเตือนระบบ NTM Arcade</h4>
          <p id="toast-message" class="text-xs text-emerald-700">ข้อความแจ้งเตือนระบบ</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="toast-play-btn" onclick="" class="hidden px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow transition-all">
          ▶️ เปิดเล่นเกมทันที
        </button>
        <button onclick="hideToast()" class="text-emerald-700 hover:text-emerald-900 text-sm font-bold px-2 py-1">✕</button>
      </div>
    </div>

    <!-- ==================== TAB 1: ARCADE PLAY ARENA ==================== -->
    <section id="sec-arcade" class="space-y-6">
      
      <!-- Section Intro Paragraph -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 mb-1">
            <span>🎮</span> ศูนย์รวมเกมออนไลน์ NTM Arcade
          </h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            รวมเกม Canvas, HTML5 และเกมระบบ AR เล่นออนไลน์บนเบราว์เซอร์ Google Chrome ได้ทันที พร้อมระบบกล้องและเซนเซอร์เต็มรูปแบบ
          </p>
        </div>
      </div>

      <!-- Controls & Filter Bar -->
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <!-- Search Bar -->
          <div class="relative flex-grow max-w-md">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              🔍
            </span>
            <input type="text" id="searchInput" oninput="filterGames()" placeholder="ค้นหาชื่อเกม, ผู้พัฒนา, หรือคำอธิบาย..." class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all">
          </div>

          <!-- Sort Select -->
          <div class="flex items-center gap-2">
            <label for="sortSelect" class="text-xs font-medium text-slate-500 whitespace-nowrap">จัดเรียง:</label>
            <select id="sortSelect" onchange="filterGames()" class="py-2.5 px-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="newest">อัปเดตใหม่ล่าสุด</option>
              <option value="popular">ยอดนิยม (เล่นมากที่สุด)</option>
              <option value="rating">คะแนนรีวิวสูงสุด</option>
            </select>
          </div>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 custom-scrollbar" id="category-filter-pills">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- Game Cards Grid View -->
      <div id="gameGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Rendered dynamically -->
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 border-dashed p-8">
        <div class="text-5xl mb-3">👾</div>
        <h3 class="font-bold text-slate-700 text-base mb-1">ไม่พบตัวเกมที่ต้องการ</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mb-4">ลองปรับเปลี่ยนคำค้นหา หรือทดลองอัปโหลดเกมใหม่เข้าสู่ระบบ NTM Arcade</p>
        <button onclick="resetFilters()" class="text-xs bg-indigo-50 text-indigo-600 px-4 py-2 rounded-xl font-medium hover:bg-indigo-100 transition-colors">
          ล้างตัวกรองทั้งหมด
        </button>
      </div>

    </section>

    <!-- ==================== TAB 2: DASHBOARD & ANALYTICS ==================== -->
    <section id="sec-dashboard" class="hidden space-y-8">
      
      <!-- Section Intro Paragraph -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 mb-2">
          <span>📊</span> แดชบอร์ดสรุปสถิติตัวเกมและการเข้าเล่น (NTM Analytics)
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          ภาพรวมข้อมูลเชิงสถิติของ NTM Arcade แสดงสัดส่วนประเภทเกม ยอดรวมจำนวนครั้งการเล่น สถิตินักพัฒนา และแนวโน้มความสนใจของผู้เล่น
        </p>
      </div>

      <!-- Stat Key Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">จำนวนเกมในระบบ</p>
            <h3 id="stat-total-games" class="text-3xl font-bold text-indigo-600">0</h3>
            <p class="text-xs text-slate-500 mt-1">เกมเปิดให้บริการ</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl">
            🎰
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">จำนวนการเล่นรวม</p>
            <h3 id="stat-total-plays" class="text-3xl font-bold text-emerald-600">0</h3>
            <p class="text-xs text-slate-500 mt-1">ครั้งของการเปิดเล่น</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl">
            ▶️
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">นักพัฒนาเกม</p>
            <h3 id="stat-total-devs" class="text-3xl font-bold text-purple-600">0</h3>
            <p class="text-xs text-slate-500 mt-1">ผู้สร้างผลงานในระบบ</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl">
            👨‍💻
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">คะแนนเฉลี่ย</p>
            <h3 id="stat-avg-rating" class="text-3xl font-bold text-amber-500">0.0</h3>
            <p class="text-xs text-slate-500 mt-1">เรตติ้งผู้ใช้งาน</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl">
            ⭐
          </div>
        </div>

      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Category Chart -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-bold text-slate-800 text-base">สัดส่วนเกมแบ่งตามประเภท</h3>
                <p class="text-xs text-slate-500">จำแนกหมวดหมู่เกมที่มีใน NTM Arcade</p>
              </div>
              <span class="text-xs bg-indigo-50 text-indigo-700 font-medium px-2.5 py-1 rounded-full">Donut Chart</span>
            </div>
            <div class="chart-container">
              <canvas id="gameCategoryChart"></canvas>
            </div>
          </div>
          <p class="text-xs text-slate-400 text-center mt-4">วางเมาส์บนกราฟเพื่อดูสัดส่วนเปอร์เซ็นต์</p>
        </div>

        <!-- Play Trend Chart -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-bold text-slate-800 text-base">แนวโน้มจำนวนครั้งการเล่นรายเดือน</h3>
                <p class="text-xs text-slate-500">ปริมาณการเล่นเกมออนไลน์ผ่านเว็บ</p>
              </div>
              <span class="text-xs bg-emerald-50 text-emerald-700 font-medium px-2.5 py-1 rounded-full">Bar Chart</span>
            </div>
            <div class="chart-container">
              <canvas id="gamePlaysTrendChart"></canvas>
            </div>
          </div>
          <p class="text-xs text-slate-400 text-center mt-4">สถิติจำนวนครั้งการเข้าเล่นเรียงตามลำดับเดือน</p>
        </div>

      </div>

    </section>

    <!-- ==================== TAB 3: UPLOAD & PUBLISH GAME ==================== -->
    <section id="sec-upload" class="hidden space-y-6">
      
      <!-- Section Intro Paragraph -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 mb-2">
          <span>🚀</span> อัปโหลดและเผยแพร่ตัวเกมใหม่ลง NTM Arcade
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          คุณสามารถนำไฟล์เกม HTML5 (.html) และเกม AR ที่ใช้กล้องถ่ายภาพ อัปโหลดเข้ามาในระบบเพื่อจัดเก็บและเปิดให้เล่นออนไลน์ได้ทันที
        </p>
      </div>

      <div class="max-w-3xl mx-auto bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200/80">
        <form id="gameUploadForm" onsubmit="handleGameUploadSubmit(event)" class="space-y-6">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Game Title -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                ชื่อเกม (Game Title) <span class="text-rose-500">*</span>
              </label>
              <input type="text" id="form-title" required placeholder="เช่น Cyber Snake 2099" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
            </div>

            <!-- Developer Name -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                ชื่อผู้พัฒนา / ทีมพัฒนา <span class="text-rose-500">*</span>
              </label>
              <input type="text" id="form-developer" required placeholder="เช่น NTM Studio" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Game Category -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                หมวดหมู่เกม <span class="text-rose-500">*</span>
              </label>
              <select id="form-category" required class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                <option value="AR / Camera">AR / WebXR (เกมกล้อง AR)</option>
                <option value="Arcade">Arcade (คลาสสิก/อาร์เคด)</option>
                <option value="Action">Action (แอคชั่น/ยิงกระจาย)</option>
                <option value="Puzzle">Puzzle (ปริศนา/ฝึกสมอง)</option>
                <option value="Sci-Fi">Sci-Fi / Space (ไซไฟ/อวกาศ)</option>
                <option value="Casual">Casual (เล่นเพลินๆ)</option>
              </select>
            </div>

            <!-- Game Engine / Format -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                รูปแบบเกม / Game Engine <span class="text-rose-500">*</span>
              </label>
              <select id="form-engine" required class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                <option value="AR.js / MindAR">AR.js / MindAR (WebAR)</option>
                <option value="HTML5 Single File">HTML5 Web File (.html)</option>
                <option value="WebGL">Unity WebGL / Godot HTML5</option>
                <option value="Construct 3">Construct 3 Web Export</option>
                <option value="Scratch Embed">Scratch / Frame Embed</option>
              </select>
            </div>
          </div>

          <!-- Cover Image Upload Zone -->
          <div class="space-y-3 bg-slate-50 p-4 rounded-2xl border border-slate-200">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">
              🖼️ ภาพหน้าปกเกม (Game Cover Image)
            </label>
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
              <!-- Upload Box -->
              <div class="sm:col-span-2 border-2 border-dashed border-purple-200 bg-purple-50/40 rounded-xl p-4 text-center hover:bg-purple-50 hover:border-purple-400 transition-all cursor-pointer" onclick="document.getElementById('form-cover-file').click()">
                <input type="file" id="form-cover-file" accept="image/*" class="hidden" onchange="handleCoverUploadChange(this)">
                <div class="text-2xl mb-1">🖼️</div>
