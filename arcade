      const labelText = document.getElementById('edit-cover-file-label');
      const previewImg = document.getElementById('edit-cover-preview-img');
      const previewPlaceholder = document.getElementById('edit-cover-preview-placeholder');

      if (input.files && input.files[0]) {
        const file = input.files[0];
        labelText.innerText = `รูปใหม่: ${file.name}`;

        compressImageFile(file, 640, 0.75, function(compressedBase64) {
          editUploadedCoverData = compressedBase64;
          previewImg.src = editUploadedCoverData;
          previewImg.classList.remove('hidden');
          previewPlaceholder.classList.add('hidden');
        });
      }
    }

    function handleEditCoverUrlInput(urlVal) {
      const previewImg = document.getElementById('edit-cover-preview-img');
      const previewPlaceholder = document.getElementById('edit-cover-preview-placeholder');

      if (urlVal && urlVal.trim() !== '') {
        previewImg.src = urlVal.trim();
        previewImg.classList.remove('hidden');
        previewPlaceholder.classList.add('hidden');
      } else if (!editUploadedCoverData) {
        const currentCover = previewImg.getAttribute('data-original-cover');
        if (currentCover) {
          previewImg.src = currentCover;
          previewImg.classList.remove('hidden');
          previewPlaceholder.classList.add('hidden');
        } else {
          previewImg.classList.add('hidden');
          previewPlaceholder.classList.remove('hidden');
        }
      }
    }

