    function toggleGameSource(type) {
      document.getElementById('active-source-type').value = type;
      
      const btns = ['file', 'code', 'url'];
      btns.forEach(b => {
        const btnElem = document.getElementById(`btn-src-${b}`);
        const zoneElem = document.getElementById(`zone-src-${b}`);
        
        if (b === type) {
          btnElem.classList.add('bg-white', 'shadow-sm', 'text-indigo-600');
          btnElem.classList.remove('text-slate-500', 'hover:text-slate-700');
          zoneElem.classList.remove('hidden');
          zoneElem.classList.add('block');
        } else {
          btnElem.classList.remove('bg-white', 'shadow-sm', 'text-indigo-600');
          btnElem.classList.add('text-slate-500', 'hover:text-slate-700');
          zoneElem.classList.add('hidden');
          zoneElem.classList.remove('block');
        }
      });
    }

    async function handleGameUploadSubmit(e) {
      e.preventDefault();

      const btn = document.getElementById('btn-save-game');
      btn.disabled = true;
      btn.innerHTML = `<span>⏳</span> กำลังประมวลผลไฟล์และอัปโหลดขึ้น Real-time Cloud...`;

      const title = document.getElementById('form-title').value.trim();
      const developer = document.getElementById('form-developer').value.trim();
      const category = document.getElementById('form-category').value;
      const engine = document.getElementById('form-engine').value;
      const description = document.getElementById('form-description').value.trim();
      const coverUrlInput = document.getElementById('form-cover-url').value.trim();

      // Get Data Based on Selected Source Type
      const sourceType = document.getElementById('active-source-type').value;
      const externalUrl = document.getElementById('form-url').value.trim();
      const rawCode = document.getElementById('form-raw-code').value.trim();
      
      let finalUploadedHtml = null;
      let finalExternalUrl = null;
      
      if (sourceType === 'file') {
        finalUploadedHtml = uploadedFileContent;
      } else if (sourceType === 'code') {
        finalUploadedHtml = rawCode || null;
      } else if (sourceType === 'url') {
        finalExternalUrl = externalUrl || null;
      }

      const newId = gameDatabase.length > 0 ? Math.max(...gameDatabase.map(g => g.id)) + 1 : 1;
      const finalCoverUrl = uploadedCoverData || coverUrlInput || `https://placehold.co/600x350/1e1b4b/818cf8?text=${encodeURIComponent(title)}`;

      const newGame = {
        id: newId,
        title: title,
        developer: developer,
        category: category,
        engine: engine,
        plays: 0,
        rating: 0.0,
        ratingCount: 0,
        ratingSum: 0,
        uploadedAt: new Date().toLocaleDateString('th-TH'),
        description: description || 'ตัวเกมใหม่เพิ่งอัปโหลดเข้าสู่คลัง NTM Arcade',
        coverUrl: finalCoverUrl,
        uploadedHtml: finalUploadedHtml,
        externalUrl: finalExternalUrl,
        gameType: finalUploadedHtml || finalExternalUrl ? null : 'snake'
      };

      await syncGameToCloud(newGame);

      btn.disabled = false;
      btn.innerHTML = `<span>🚀</span> เผยแพร่เกมลง NTM Arcade`;
      resetGameForm();

      currentCategoryFilter = 'ALL';
      renderArcadeCategoryPills();
      filterGames();
      renderDashboardAnalytics();

      showToastWithPlayAction(`เกม "${title}" อัปโหลดขึ้นระบบ Real-Time เรียบร้อยแล้ว!`, newId);
      switchTab('arcade');
    }

    function resetGameForm() {
      document.getElementById('gameUploadForm').reset();
      document.getElementById('file-label-text').innerText = `คลิกเลือกไฟล์ตัวเกม HTML5 หรือ AR (.html)`;
      document.getElementById('cover-file-label-text').innerText = `อัปโหลดไฟล์ภาพหน้าปก (.png, .jpg, .webp)`;
      document.getElementById('cover-preview-img').classList.add('hidden');
      document.getElementById('cover-preview-placeholder').classList.remove('hidden');
      document.getElementById('form-raw-code').value = '';
      toggleGameSource('file'); // Reset to file upload tab
      uploadedFileContent = null;
      uploadedCoverData = null;
    }

    function showToastWithPlayAction(msg, gameId) {
      const toast = document.getElementById('toast-notification');
      const msgElem = document.getElementById('toast-message');
      const playBtn = document.getElementById('toast-play-btn');

      msgElem.innerText = msg;
      if (gameId) {
        playBtn.classList.remove('hidden');
        playBtn.onclick = function() {
          launchGameEngine(gameId);
          hideToast();
        };
      } else {
        playBtn.classList.add('hidden');
      }

      toast.classList.remove('hidden');
      setTimeout(() => hideToast(), 8000);
    }

    function hideToast() {
      document.getElementById('toast-notification').classList.add('hidden');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    Object.assign(window, {
      switchTab,
      toggleAdminAuth,
      openAdminLoginModal,
      closeAdminLoginModal,
      handleAdminLoginSubmit,
      filterGames,
      resetFilters,
      selectCategoryFilter,
      handleGameUploadSubmit,
      handleCoverUploadChange,
      handleFileUploadChange,
      handleCoverUrlInput,
      toggleGameSource,
      resetGameForm,
      hideToast,
      copyActiveGameDirectLink,
      copyGameDirectLink,
      toggleFullscreen,
      closeGameModal,
      restartCurrentGame,
      openEditGameModal,
      openDeleteGameModal,
      closeDeleteModal,
      executeDeleteGame,
      closeAdminEditModal,
      handleEditCoverUploadChange,
      handleEditCoverUrlInput,
      handleSaveEditedGame,
      submitGameRating,
      launchGameEngine,
      requestParentCameraPermission
    });
  </script>
</body>
