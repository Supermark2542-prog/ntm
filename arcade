    let currentModalGameId = null;

    async function requestParentCameraPermission() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true });
        stream.getTracks().forEach(track => track.stop());
        showToastWithPlayAction("อนุมัติสิทธิ์ใช้งานกล้องถ่ายภาพเรียบร้อยแล้ว!", null);

        const iframe = document.getElementById('game-iframe');
        if (iframe && iframe.srcdoc) {
          const currentSrcdoc = iframe.srcdoc;
          iframe.srcdoc = '';
          setTimeout(() => { iframe.srcdoc = currentSrcdoc; }, 150);
        } else if (iframe && iframe.src && iframe.src !== 'about:blank') {
          const currentSrc = iframe.src;
          iframe.src = 'about:blank';
          setTimeout(() => { iframe.src = currentSrc; }, 150);
        }
      } catch (err) {
        console.error("Camera access error:", err);
        showToastWithPlayAction("ไม่สามารถเข้าถึงกล้องได้: โปรดตรวจสอบว่าได้เปิดเว็บด้วย HTTPS หรือไม่ได้บล็อกกล้องในการตั้งค่าเบราว์เซอร์", null);
      }
    }

    async function submitGameRating(gameId, stars) {
      const game = gameDatabase.find(g => g.id == gameId);
      if (!game) return;

      game.ratingSum = (game.ratingSum || 0) + stars;
      game.ratingCount = (game.ratingCount || 0) + 1;
      game.rating = game.ratingSum / game.ratingCount;

      await syncGameToCloud(game);
      filterGames();
      renderDashboardAnalytics();

      if (currentModalGameId == gameId) {
        renderModalRatingStars(game);
      }

      showToastWithPlayAction(`ขอบคุณสำหรับการให้คะแนน ${stars} ดาวแก่เกม "${game.title}"!`, null);
    }

    async function launchGameEngine(gameId) {
      checkAndAutoOpenChrome();

      const game = gameDatabase.find(g => g.id == gameId);
      if (!game) return;

      currentModalGameId = gameId;
      game.plays = (game.plays || 0) + 1;

      await syncGameToCloud(game);
      filterGames();
      renderDashboardAnalytics();

      const titleElem = document.getElementById('player-game-title');
      const catElem = document.getElementById('player-game-category');
      const engineElem = document.getElementById('player-game-engine');
      if (titleElem) titleElem.innerText = game.title;
      if (catElem) catElem.innerText = game.category;
      if (engineElem) engineElem.innerText = game.engine;

      renderModalRatingStars(game);

      const canvas = document.getElementById('game-canvas');
      const iframe = document.getElementById('game-iframe');
      const restartBtn = document.getElementById('btn-restart-canvas');
      const arNotice = document.getElementById('ar-camera-notice');

      const isARGame = game.category === 'AR / Camera' || (game.engine && game.engine.includes('AR'));

      if (isARGame && arNotice) {
        arNotice.classList.remove('hidden');
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ video: true });
          stream.getTracks().forEach(track => track.stop());
        } catch (e) {
          console.log("Pre-request camera prompt:", e);
        }
      } else if (arNotice) {
        arNotice.classList.add('hidden');
      }

      if (game.uploadedHtml) {
        if (canvas) canvas.classList.add('hidden');
        if (iframe) {
          iframe.classList.remove('hidden');
          iframe.removeAttribute('sandbox');
          iframe.setAttribute('allow', 'camera *; microphone *; accelerometer *; gyroscope *; magnetometer *; xr-spatial-tracking *; autoplay *; fullscreen *; geolocation *');
          iframe.srcdoc = game.uploadedHtml;
        }
        if (restartBtn) restartBtn.classList.add('hidden');
        document.getElementById('player-game-controls').innerText = isARGame ? 'ส่องกล้องถ่ายภาพเพื่อเล่นเกม AR • กด ⛶ เพื่อขยายเต็มจอ' : 'ควบคุมผ่านหน้าจอเกม HTML5 • กด ⛶ เพื่อขยายเต็มจอ';
      } else if (game.externalUrl) {
        if (canvas) canvas.classList.add('hidden');
        if (iframe) {
          iframe.classList.remove('hidden');
          iframe.removeAttribute('sandbox');
          iframe.setAttribute('allow', 'camera *; microphone *; accelerometer *; gyroscope *; magnetometer *; xr-spatial-tracking *; autoplay *; fullscreen *; geolocation *');
          iframe.srcdoc = '';
          iframe.src = game.externalUrl;
        }
        if (restartBtn) restartBtn.classList.add('hidden');
        document.getElementById('player-game-controls').innerText = 'ควบคุมผ่านเว็บฝั่งภายนอก • กด ⛶ เพื่อขยายเต็มจอ';
      } else {
        if (iframe) {
          iframe.classList.add('hidden');
          iframe.srcdoc = '';
        }
        if (canvas) canvas.classList.remove('hidden');
        if (restartBtn) restartBtn.classList.remove('hidden');
        activeGameType = game.gameType || 'snake';
        initSelectedGame(activeGameType);
      }

      document.getElementById('game-player-modal').classList.remove('hidden');
    }

